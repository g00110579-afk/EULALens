# Node >=22.13 is required (durable jobs use node:sqlite for a crash-safe worker lease).
PORT=5050
HOST=127.0.0.1
MOCK_MODE=false
PRESENTATION_MODE=false
PRESENTATION_PRECOMPUTED_ROOT=public/precomputed_data
MAX_ANALYZE_PAYLOAD_MB=4

# Signed anonymous sessions isolate user jobs; these are not account logins.
# Add your deployed frontend's exact origin. Keep the job directory persistent/private.
EULALENS_ALLOWED_ORIGINS=https://g00110579-afk.github.io,http://localhost:5173,http://127.0.0.1:5173
# EULALENS_JOB_DIR=/persistent/private/eulalens/jobs
# Optional private-instance session-creation gate. Clients must supply X-Access-Token.
EULALENS_ACCESS_TOKEN=
JOB_MAX_PENDING=64
JOB_MAX_PER_SESSION=32
JOB_MAX_RECORDS=1000
JOB_RETENTION_MS=86400000
JOB_DEADLINE_MS=3600000
# At most one image and one video render; they can overlap on this dual-model GPU.
MEDIA_CONCURRENCY=2

# Comic narration reuses the installed Kokoro-82M environment and cached af_heart voice.
# The API finds a sibling kokoro-tts conda environment, or uses this explicit executable.
# EULALENS_KOKORO_PYTHON=/path/to/kokoro-tts/bin/python

# Qwen OpenAI-compatible endpoint; use the same key as the vLLM launcher.
QWEN_API_KEY=
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen3.5-9b
QWEN_CHUNK_CHARS=3500
QWEN_MAX_TOKENS=4096
QWEN_CONTEXT_TOKENS=16384
QWEN_GLOBAL_CONCURRENCY=3
QWEN_EXTRACTION_CONCURRENCY=2
QWEN_MAX_QUEUE=128
QWEN_REQUEST_TIMEOUT_MS=180000
QWEN_MAX_ATTEMPTS=3
# auto uses /tokenize; required fails if unavailable; conservative uses UTF-8 bounds.
QWEN_TOKENIZER_MODE=auto
# QWEN_TOKENIZE_URL=http://127.0.0.1:8000/tokenize
QWEN_CARD_MAX_TOKENS=1200
QWEN_CARD_BATCH_CONCURRENCY=3
QWEN_COMIC_SCRIPT_MAX_TOKENS=5600
QWEN_VIDEO_SCRIPT_MAX_TOKENS=1800
QWEN_VIDEO_DURATION_SECONDS=30
QWEN_DEBUG_OUTPUT=false

# HiDream O1 supports its native 2048 square image and fixed 28 dev steps.
HIDREAM_IMAGE_API_URL=http://127.0.0.1:5052
HIDREAM_API_KEY=
HIDREAM_IMAGE_TIMEOUT_MS=900000

VIDEO_PROVIDER=ltx-local
VIDEO_API_KEY=
VIDEO_API_URL=http://127.0.0.1:5054/generate
VIDEO_MODEL=
VIDEO_DURATION_SECONDS=30
VIDEO_ASPECT_RATIO=16:9
VIDEO_TIMEOUT_MS=1800000
VIDEO_POLL_INTERVAL_MS=2000
VIDEO_STATUS_URL_TEMPLATE=
VIDEO_CANCEL_URL_TEMPLATE=
# Optional external media CDN origins, comma-separated. Redirects are not followed.
MEDIA_ALLOWED_ORIGINS=

# Original React UI build knobs, ignored by the redesigned static UI.
VITE_CARD_PRELOAD_BATCH_SIZE=3
VITE_COMIC_PRELOAD_CONCURRENCY=2
VITE_VIDEO_SCRIPT_PRELOAD_CONCURRENCY=1
# Original serverless adapters must point to the persistent backend; never model ports.
EULALENS_BACKEND_ORIGIN=
