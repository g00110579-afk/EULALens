CONDA_ENV=hidream-o1
CUDA_VISIBLE_DEVICES=0
FA_VERSION=none
HIDREAM_USE_FLASH_ATTN=false

HIDREAM_HOST=127.0.0.1
HIDREAM_PORT=5052
HIDREAM_API_KEY=
HIDREAM_PRELOAD_ON_STARTUP=true
HIDREAM_REPO_DIR=repo/HiDream-O1-Image
HIDREAM_MODEL_ID=HiDream-ai/HiDream-O1-Image-Dev-2604
HIDREAM_MODEL_DIR=models/HiDream-O1-Image-Dev-2604
HIDREAM_OUTPUT_DIR=/data/d1/vanishri/EULALens/Data/experiments/image-generation/hidream-o1/app-renders
HIDREAM_PUBLIC_BASE_URL=http://localhost:5052

HIDREAM_MODEL_TYPE=dev
HIDREAM_HEIGHT=2048
HIDREAM_WIDTH=2048
HIDREAM_STEPS=28
HIDREAM_SHIFT=1.0
HIDREAM_GUIDANCE_SCALE=0.0
HIDREAM_TORCH_DTYPE=bfloat16
HIDREAM_SEED=42
HIDREAM_SCHEDULER=flash
HIDREAM_NOISE_SCALE_START=8.0
HIDREAM_NOISE_SCALE_END=8.0
HIDREAM_NOISE_CLIP_STD=8.0

HIDREAM_USE_PROMPT_REFINE=false
HIDREAM_PROMPT_REFINE_BASE_URL=http://localhost:8100/v1
HIDREAM_PROMPT_REFINE_MODEL=HiDream-ai/Prompt-Refine
HIDREAM_PROMPT_REFINE_API_KEY=hidream
HIDREAM_PROMPT_REFINE_MAX_TOKENS=2048

PROMPT_REFINE_CUDA_VISIBLE_DEVICES=0
PROMPT_REFINE_PORT=8100
PROMPT_REFINE_MODEL_ID=HiDream-ai/Prompt-Refine
PROMPT_REFINE_GPU_MEMORY_UTILIZATION=0.85
VLLM_CONDA_ENV=vllm-omni
