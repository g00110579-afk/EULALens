MODEL_ID=Qwen/Qwen3.5-9B
SERVED_MODEL_NAME=qwen3.5-9b
HOST=127.0.0.1
PORT=8000
VLLM_API_KEY=

# Reuse the existing shared Hugging Face cache under /media/main/Data/Abhijeet.
HF_HOME=/data/d1/vanishri/huggingface

# Pin Qwen to physical GPU 0.
CUDA_VISIBLE_DEVICES=0

# Keep the default context moderate so a 9B model does not over-allocate KV cache.
# Raise this if your GPU has enough VRAM and you need longer EULA inputs.
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.46
TENSOR_PARALLEL_SIZE=1
DTYPE=auto

# The launcher will re-run itself through this conda env when vllm is not active.
CONDA_ENV=vllm-omni

# Leave false unless the installed vLLM/Transformers build needs custom HF code.
TRUST_REMOTE_CODE=false

# Optional: pass extra vLLM flags as a simple space-separated string.
# VLLM_EXTRA_ARGS=--enable-auto-tool-choice
